{
  "name": "promptions-adaptive-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Human-guided associative exploration before an AI answer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build --config vite.prethink.config.mjs",
    "build:prethink": "npm run build",
    "build:widget": "tsc --noEmit && vite build --config vite.prethink-widget.config.mjs",
    "start": "node --env-file-if-exists=.env --use-env-proxy server/prethink-server.mjs",
    "start:prethink": "npm start",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "check": "npm test && npm run build && npm run test:ui",
    "install:probe": "npm ci --prefix probe --ignore-scripts --no-audit --no-fund",
    "start:probe": "node probe/server.mjs",
    "test:probe": "npm test --prefix probe && playwright test --config probe/playwright.config.mjs",
    "start:chatgpt": "node --env-file-if-exists=.env --use-env-proxy probe/live-server.mjs",
    "test:chatgpt": "npm run build:widget && npm test --prefix probe && playwright test --config probe/live-playwright.config.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  }
}
